generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  createdAt    DateTime @default(now())
  
  // Relations
  joinedEvents Event[]  @relation("EventParticipants")
}

model Event {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  category        String
  city            String
  date            DateTime
  maxParticipants Int
  createdAt       DateTime @default(now())

  // Relations
  participants    User[]   @relation("EventParticipants")
}